# Orange Test Environment Configuration

# Maximum candidate subdomains extracted from Certificate Transparency (crt.sh)
MAX_CANDIDATES=1000

# Concurrency limit for DNS lookups (default: 25)
DNS_CONCURRENCY=25

# Network request timeout in seconds
REQUEST_TIMEOUT=30

# Maximum number of Cloudflare IP matches returned
MAX_RESULTS=500

# Rate limit window in seconds per client IP (default: 0 = disabled, or set to 60 for strict limits)
RATE_LIMIT_SECONDS=0

# Cache TTL for Cloudflare IP ranges in seconds (default: 3600 = 1 hour)
CF_CACHE_TTL_SECONDS=3600

# Allowed CORS origins (comma-separated, leave empty for same-origin only)
# ALLOWED_ORIGINS=https://my-authorized-client.com

# Optional server-side API Key for authorized third-party client integrations
# API_ACCESS_KEY=

